{
  "schemaVersion": 1,
  "id": "shrinecraft",
  "version": "${version}",
  "name": "Tuff SMP",
  "description": "Fourteen hand-crafted 3D legendary items, obtainable only from the Shrine block.",
  "authors": [
    "Tuff SMP"
  ],
  "license": "All rights reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.tuffsmp.shrinecraft.ShrineCraft"
    ],
    "client": [
      "dev.tuffsmp.shrinecraft.client.ShrineCraftClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "shrinecraft.mixins.json",
    {
      "config": "shrinecraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "icon": "assets/shrinecraft/icon.png"
}